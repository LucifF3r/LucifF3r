{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RevlineMotors POS",
  "version": "1.0.0",
  "identifier": "com.revlinemotors.pos",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "RevlineMotors POS",
        "url": "https://revcycle-iota.vercel.app",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
